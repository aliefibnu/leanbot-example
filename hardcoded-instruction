#include <Leanbot.h>

// =============================================================================
// KONFIGURASI (semua jarak dalam cm, sudut dalam derajat)
// =============================================================================
const int OBJ_THRESHOLD_CM = 10;   // jarak deteksi objek default (cm)
const int SCAN_SPEED_RPM   = 25;   // kecepatan saat scan
const int SCAN_MAX_DEG     = 720;  // batas putar sebelum menyerah
const int SCAN_STEP_DEG    = 5;    // resolusi scan
const int GRIPPER_DURATION = 800;  // durasi gerak gripper (ms)

// =============================================================================
// VARIABEL PERINTAH
// =============================================================================
// Semua jarak dalam cm, sudut dalam derajat.
// Pisahkan perintah dengan ';'
String command = "CARI_OBJEK:10;MAJU:8;CAPIT;MUNDUR:8;BUNYI:2;STOP";
bool   commandDone = false;

// =============================================================================
// STATE GRIPPER
// =============================================================================
bool isGripperMoving = false;
unsigned long gripperStartTime = 0;
int currentGripperL = 0;
int currentGripperR = 0;
int targetGripperL  = 0;
int targetGripperR  = 0;

// =============================================================================
// GERAK DASAR (jarak cm → dikonversi ke mm untuk library)
// =============================================================================
void gerakMaju(int cm)   { LbMotion.runLRrpm(30, 30);   LbMotion.waitDistanceMm(cm * 10); LbMotion.stopAndWait(); }
void gerakMundur(int cm) { LbMotion.runLRrpm(-30, -30); LbMotion.waitDistanceMm(cm * 10); LbMotion.stopAndWait(); }
void belokKiri(int deg)  { LbMotion.runLRrpm(-30, 30);  LbMotion.waitRotationDeg(deg); LbMotion.stopAndWait(); }
void belokKanan(int deg) { LbMotion.runLRrpm(30, -30);  LbMotion.waitRotationDeg(deg); LbMotion.stopAndWait(); }

void bunyikan(int kali) {
  while (kali--) { Leanbot.tone(1500, 100); delay(150); }
}

// =============================================================================
// GRIPPER (pakai API Leanbot: LbGripper.open/close/moveToLR)
// =============================================================================
void updateGripper() {
  if (isGripperMoving && (millis() - gripperStartTime > GRIPPER_DURATION)) {
    isGripperMoving = false;
    currentGripperL = targetGripperL;
    currentGripperR = targetGripperR;
    Serial.println(F("STATUS: Gripper movement complete"));
  }
}

void capitBuka() {
  LbGripper.open();
  targetGripperL = -90;
  targetGripperR = -90;
  isGripperMoving = true;
  gripperStartTime = millis();
  Serial.println(F("STATUS: Gripper OPENING"));
  bunyikan(1);
}

void capitTutup() {
  LbGripper.close();
  targetGripperL = 90;
  targetGripperR = 90;
  isGripperMoving = true;
  gripperStartTime = millis();
  Serial.println(F("STATUS: Gripper CLOSING"));
  bunyikan(1);
}

void capitGrab() {
  LbGripper.moveToLR(90, 90, GRIPPER_DURATION);
  targetGripperL = 90;
  targetGripperR = 90;
  isGripperMoving = true;
  gripperStartTime = millis();
  Serial.println(F("STATUS: GRABBING OBJECT"));
  bunyikan(2);
}

void capitRelease() {
  LbGripper.moveToLR(-90, -90, GRIPPER_DURATION);
  targetGripperL = -90;
  targetGripperR = -90;
  isGripperMoving = true;
  gripperStartTime = millis();
  Serial.println(F("STATUS: RELEASING OBJECT"));
  bunyikan(2);
}

// =============================================================================
// DETEKSI OBJEK (cm)
// =============================================================================
bool cariObjek(int thresholdCm, int maxDeg) {
  Serial.print(F("Mencari objek < "));
  Serial.print(thresholdCm);
  Serial.println(F(" cm..."));

  int totalDeg = 0;

  while (totalDeg < maxDeg) {
    int d = Leanbot.pingCm();
    Serial.print(F("Jarak: ")); Serial.print(d); Serial.println(F(" cm"));

    if (d > 0 && d <= thresholdCm) {
      LbMotion.stopAndWait();
      Serial.println(F(">> OBJEK DITEMUKAN"));
      bunyikan(2);
      return true;
    }

    LbMotion.runLRrpm(-SCAN_SPEED_RPM, SCAN_SPEED_RPM);
    LbMotion.waitRotationDeg(SCAN_STEP_DEG);
    LbMotion.stopAndWait();
    totalDeg += SCAN_STEP_DEG;
  }

  Serial.println(F(">> Objek tidak ditemukan"));
  return false;
}

// =============================================================================
// PARSER PERINTAH
// =============================================================================
void eksekusiPerintah(String cmd) {
  cmd.trim();
  cmd.toUpperCase();
  if (cmd.length() == 0) return;

  Serial.print(F(">> Eksekusi: "));
  Serial.println(cmd);

  int sep = cmd.indexOf(':');
  String aksi  = (sep == -1) ? cmd : cmd.substring(0, sep);
  String param = (sep == -1) ? ""  : cmd.substring(sep + 1);
  int nilai    = param.toInt();

  if (aksi == "CARI_OBJEK") {
    int thr = (nilai > 0) ? nilai : OBJ_THRESHOLD_CM;
    cariObjek(thr, SCAN_MAX_DEG);
  }
  else if (aksi == "MAJU")    { gerakMaju(nilai > 0 ? nilai : 10); }
  else if (aksi == "MUNDUR")  { gerakMundur(nilai > 0 ? nilai : 10); }
  else if (aksi == "KIRI")    { belokKiri(nilai > 0 ? nilai : 90); }
  else if (aksi == "KANAN")   { belokKanan(nilai > 0 ? nilai : 90); }
  else if (aksi == "BUNYI")   { bunyikan(nilai > 0 ? nilai : 1); }
  else if (aksi == "CAPIT")   { capitTutup(); }
  else if (aksi == "LEPAS")   { capitBuka(); }
  else if (aksi == "GRAB")    { capitGrab(); }
  else if (aksi == "RELEASE") { capitRelease(); }
  else if (aksi == "AMBIL") {
    // Cari objek → maju mendekat → grab → mundur (sekali jalan)
    int thr = (nilai > 0) ? nilai : OBJ_THRESHOLD_CM;
    if (cariObjek(thr, SCAN_MAX_DEG)) {
      int majuCm = (thr - 2 > 0) ? (thr - 2) : 1;
      gerakMaju(majuCm);
      capitGrab();
      gerakMundur(majuCm);
    }
  }
  else if (aksi == "TARUH") {
    // Maju → release → mundur (sekali jalan)
    int jarakCm = (nilai > 0) ? nilai : 5;
    gerakMaju(jarakCm);
    capitRelease();
    gerakMundur(jarakCm);
  }
  else if (aksi == "STOP") {
    LbMotion.stopAndWait();
    Leanbot.noTone();
    LbRGB.clear();
    LbRGB.show();
  }
  else if (aksi == "LED") {
    long warna = strtol(param.c_str(), NULL, 16);
    LbRGB.fillColor((uint32_t)warna);
    LbRGB.show();
  }
  else {
    Serial.println(F("?? Perintah tidak dikenal"));
  }
}

// =============================================================================
// BATCH EXECUTOR
// =============================================================================
void eksekusiBatch(String batch) {
  int start = 0;
  while (start < batch.length()) {
    int end = batch.indexOf(';', start);
    if (end == -1) end = batch.length();
    eksekusiPerintah(batch.substring(start, end));
    start = end + 1;
  }
}

// =============================================================================
// SETUP / LOOP
// =============================================================================
void setup() {
  Leanbot.begin();
  Serial.begin(115200);
  Serial.println(F("=== Leanbot Command Runner + Gripper (cm, deg) ==="));
  Serial.print(F("Queue: ")); Serial.println(command);

  // Pastikan gripper terbuka saat start
  LbGripper.open();
  delay(GRIPPER_DURATION);
  currentGripperL = -90;
  currentGripperR = -90;
}

void loop() {
  updateGripper();

  if (!commandDone && command.length() > 0) {
    eksekusiBatch(command);
    commandDone = true;
    Serial.println(F("=== Semua perintah selesai ==="));
  }
  delay(20);
}
